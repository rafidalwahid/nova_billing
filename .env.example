APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=billing_production
DB_USERNAME=billing_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nova Configuration
NOVA_LICENSE_KEY=

# Billing Configuration
BILLING_DEFAULT_CURRENCY=USD
INVOICE_NUMBER_PREFIX=INV-
INVOICE_NUMBER_LENGTH=6
INVOICE_DUE_DAYS=30
INVOICE_LATE_FEE_PERCENTAGE=1.5
INVOICE_LATE_FEE_GRACE_DAYS=7
INVOICE_AUTO_GENERATE=true

# Payment Method Configuration
PAYMENT_CREDIT_CARD_ENABLED=true
PAYMENT_CREDIT_CARD_FEE=2.9
PAYMENT_CREDIT_CARD_FIXED_FEE=0.30
PAYMENT_BANK_TRANSFER_ENABLED=true
PAYMENT_BANK_TRANSFER_FEE=0.0
PAYMENT_BANK_TRANSFER_FIXED_FEE=0.0
PAYMENT_PAYPAL_ENABLED=true
PAYMENT_PAYPAL_FEE=3.49
PAYMENT_PAYPAL_FIXED_FEE=0.49
PAYMENT_STRIPE_ENABLED=true
PAYMENT_STRIPE_FEE=2.9
PAYMENT_STRIPE_FIXED_FEE=0.30
PAYMENT_CHECK_ENABLED=false

# Subscription Configuration
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
SUBSCRIPTION_SUSPENSION_DAYS=7
SUBSCRIPTION_CANCELLATION_DAYS=30
SUBSCRIPTION_PRORATION_ENABLED=true

# Tax Configuration
TAX_CALCULATION_ENABLED=true
TAX_DEFAULT_RATE=0.0875
TAX_US_DEFAULT_RATE=0.0875
TAX_US_CA_RATE=0.0975
TAX_US_NY_RATE=0.08
TAX_US_TX_RATE=0.0825
TAX_US_FL_RATE=0.06
TAX_US_WA_RATE=0.065
TAX_US_OR_RATE=0.0
TAX_CA_DEFAULT_RATE=0.13
TAX_GB_DEFAULT_RATE=0.20
TAX_FALLBACK_RATE=0.10

# Billing Limits
MAX_PAYMENT_AMOUNT=999999.99
MIN_PAYMENT_AMOUNT=0.01
MAX_INVOICE_AMOUNT=999999.99
MAX_REFUND_DAYS=30
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_HOURS=24

# Notification Settings
NOTIFY_INVOICE_GENERATED=true
NOTIFY_PAYMENT_RECEIVED=true
NOTIFY_PAYMENT_FAILED=true
NOTIFY_SUBSCRIPTION_EXPIRING=true
NOTIFY_SUBSCRIPTION_EXPIRED=true
NOTIFY_INVOICE_OVERDUE=true
NOTIFY_EXPIRATION_WARNING_DAYS_1=30
NOTIFY_EXPIRATION_WARNING_DAYS_2=7
NOTIFY_EXPIRATION_WARNING_DAYS_3=1

# Audit Configuration
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=2555
AUDIT_LOG_ALL_CHANGES=true
AUDIT_LOG_FINANCIAL_ONLY=false

# Security Configuration
SECURITY_EMAIL_VERIFICATION=true
SECURITY_TWO_FACTOR=false
SECURITY_SESSION_TIMEOUT=120
SECURITY_PASSWORD_EXPIRY_DAYS=90

# Rate Limiting Configuration
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_TICKET=5
RATE_LIMIT_PAYMENT=3
RATE_LIMIT_INVOICE=10
