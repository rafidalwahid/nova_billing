{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vue/vue3-recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "plugins": [
    "vue"
  ],
  "rules": {
    "vue/multi-word-component-names": "off",
    "vue/no-unused-vars": "error",
    "vue/no-mutating-props": "error",
    "vue/require-default-prop": "error",
    "vue/require-prop-types": "error",
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "semi": ["error", "never"],
    "quotes": ["error", "single"]
  },
  "globals": {
    "Nova": "readonly"
  }
}
